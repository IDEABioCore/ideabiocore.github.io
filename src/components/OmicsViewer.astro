---
// Live metabolomics/proteomics network (react-three-fiber + three.js, ported
// from 3dbioreactor/ — see src/three/omics/). `client:only="react"` for the
// same reason as the other two viewers: Canvas needs a real WebGL context,
// which Astro's static build (Node) doesn't have.
import IdleOmicsNetwork from '../three/omics/IdleOmicsNetwork.jsx';
---

<div class="omics-viewer">
  <IdleOmicsNetwork client:only="react" />
</div>

<style>
  .omics-viewer { width: 100%; height: 100%; }
  .omics-viewer :global(canvas) { display: block; touch-action: none; }
</style>
