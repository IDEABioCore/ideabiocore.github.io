---
// Live Design → Build → Test → Learn cycle (react-three-fiber + three.js,
// ported from 3dbioreactor/ — see src/three/dbtl/). `client:only="react"` for
// the same reason as BioreactorViewer: Canvas needs a real WebGL context,
// which Astro's static build (Node) doesn't have.
//
// Deliberately no background treatment here (unlike the homepage reactor,
// which gets its own dark "stage") — this sits inside PageHero's ordinary
// media card, transparent, showing whatever the page's normal background
// is, so it reads as part of the same uniform system as every other page's
// hero photo rather than a one-off showcase.
import IdleStrainEngineering from '../three/dbtl/IdleStrainEngineering.jsx';
---

<div class="dbtl-viewer">
  <IdleStrainEngineering client:only="react" />
</div>

<style>
  .dbtl-viewer { width: 100%; height: 100%; }
  .dbtl-viewer :global(canvas) { display: block; }
</style>
